# Celeste Core local configuration example.
# Copy to celeste-core/.env and keep real secrets out of Git.

CELESTE_API_TOKEN=replace-with-a-long-random-token

# Optional. If omitted, Core uses ../CelesteBrain relative to celeste-core.
# CELESTE_BRAIN_DIR=C:\Users\YourUser\CelesteBrain

# V0.4 supports three providers:
# - local_rules: deterministic offline fallback, no model required.
# - ollama: local conversational model through Ollama (recommended for daily local use).
# - openai: optional cloud provider.
CELESTE_LLM_PROVIDER=local_rules
CELESTE_LLM_MODEL=gpt-5.6
CELESTE_LLM_TIMEOUT_SECONDS=60

# Ollama only. Defaults shown below; no API key is required for localhost.
# CELESTE_OLLAMA_URL=http://127.0.0.1:11434
# CELESTE_OLLAMA_THINK=false
# CELESTE_OLLAMA_KEEP_ALIVE=30m
# Keeping the model warm avoids repeated reload latency during a normal Celeste session.
# Lower this value if you prefer Ollama to release GPU memory sooner.
# When CELESTE_LLM_PROVIDER=ollama and CELESTE_LLM_MODEL is omitted,
# Celeste defaults to qwen3.5:9b.

# OpenAI only.
# OPENAI_API_KEY=replace-with-your-private-openai-api-key

# Gmail V0.4.1 is disabled until OAuth is configured locally.
CELESTE_GMAIL_ENABLED=false
# CELESTE_GMAIL_CREDENTIALS_FILE=C:\Dev\Celeste\celeste-dev\celeste-core\.secrets\gmail-credentials.json
# CELESTE_GMAIL_TOKEN_FILE=C:\Dev\Celeste\celeste-dev\celeste-core\.secrets\gmail-token.json

# Optional Gmail unread monitor. 0 = disabled. Non-zero values are clamped
# between 60 and 3600 seconds. It only creates local Celeste notices; it does
# not reply, draft or send mail automatically.
CELESTE_GMAIL_POLL_SECONDS=0

# Calendar V0.4.2 is disabled until OAuth is configured locally.
CELESTE_CALENDAR_ENABLED=false
# CELESTE_CALENDAR_CREDENTIALS_FILE=C:\Dev\Celeste\celeste-dev\celeste-core\.secrets\calendar-credentials.json
# CELESTE_CALENDAR_TOKEN_FILE=C:\Dev\Celeste\celeste-dev\celeste-core\.secrets\calendar-token.json
# CELESTE_CALENDAR_ID=primary
# CELESTE_CALENDAR_TIME_ZONE=America/Bogota

# Local reminders monitor poll interval in seconds. Clamped between 5 and 300.
CELESTE_REMINDER_POLL_SECONDS=30

# Semantic memory (hybrid FTS5 + embeddings) for search_memory is disabled
# until you run `ollama pull bge-m3` once and enable it below. Uses the same
# local Ollama instance regardless of CELESTE_LLM_PROVIDER, since it is free
# and independent of which chat provider is configured. If Ollama or the
# model becomes unreachable afterward, search degrades to keyword-only FTS5
# automatically - it never breaks search_memory or note writes.
CELESTE_EMBEDDINGS_ENABLED=false
# CELESTE_EMBEDDING_MODEL=bge-m3

# web_search: lets Celeste query the public internet through a self-hosted
# SearXNG instance (see docker/searxng/, ADR-012). Free and unlimited - no API
# key, no request quota. Requires:
#   1. Docker installed.
#   2. `docker compose up -d` inside celeste-core/docker/searxng
# Disabled by default like Gmail/Calendar/embeddings.
CELESTE_WEB_SEARCH_ENABLED=false
# CELESTE_SEARXNG_URL=http://127.0.0.1:8890

# code_task: delegates a coding task to Claude Code CLI inside a sandboxed
# Docker container (see docs/CODE_TASK.md and ADR-011). Celeste only prepares
# a brief and a ready-to-run script; it never executes anything itself - you
# run the generated script yourself after reviewing it. Requires:
#   1. Docker installed.
#   2. `docker build -t celeste-code-task celeste-core/docker/code-task`
#   3. `claude setup-token` once, paste the result below (uses your Claude
#      subscription session, not a separate metered API key).
# CELESTE_CODE_TASK_OAUTH_TOKEN=replace-with-the-token-from-claude-setup-token
# Semicolon-separated absolute paths the sandbox may mount. Defaults to just
# this repo if omitted.
# CELESTE_CODE_TASK_ALLOWED_DIRS=C:\Dev\Celeste\celeste-dev
# CELESTE_CODE_TASK_IMAGE=celeste-code-task:latest
# Hard wall-clock timeout for one run, in seconds. Clamped between 30 and 3600.
# CELESTE_CODE_TASK_TIMEOUT_SECONDS=600

# Privacy notes:
# - Celeste's OpenAI provider sends Responses requests with store=false.
# - The Ollama provider talks to the configured local Ollama endpoint.
# - Gmail OAuth credentials/tokens stay local and are ignored by Git.
# - Calendar OAuth credentials/tokens stay local and are ignored by Git.
# - Calendar events are external content and are marked untrusted, like Gmail.
# - Do not place API keys, OAuth refresh tokens or other secrets in Celeste Brain notes.
