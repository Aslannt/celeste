# Celeste Core local configuration example.
# Copy to celeste-core/.env and keep real secrets out of Git.

CELESTE_API_TOKEN=replace-with-a-long-random-token

# Optional. If omitted, Core uses ../CelesteBrain relative to celeste-core.
# CELESTE_BRAIN_DIR=C:\Users\YourUser\CelesteBrain

# V0.4 supports three providers:
# - local_rules: deterministic offline fallback, no model required.
# - ollama: local conversational model through Ollama (recommended for daily local use).
# - openai: optional cloud provider.
CELESTE_LLM_PROVIDER=local_rules
CELESTE_LLM_MODEL=gpt-5.6
CELESTE_LLM_TIMEOUT_SECONDS=60

# Ollama only. Defaults shown below; no API key is required for localhost.
# CELESTE_OLLAMA_URL=http://127.0.0.1:11434
# CELESTE_OLLAMA_THINK=false
# CELESTE_OLLAMA_KEEP_ALIVE=30m
# Keeping the model warm avoids repeated reload latency during a normal Celeste session.
# Lower this value if you prefer Ollama to release GPU memory sooner.
# When CELESTE_LLM_PROVIDER=ollama and CELESTE_LLM_MODEL is omitted,
# Celeste defaults to qwen3.5:9b.

# OpenAI only.
# OPENAI_API_KEY=replace-with-your-private-openai-api-key

# Gmail V0.4.1 is disabled until OAuth is configured locally.
CELESTE_GMAIL_ENABLED=false
# CELESTE_GMAIL_CREDENTIALS_FILE=C:\Dev\Celeste\celeste-dev\celeste-core\.secrets\gmail-credentials.json
# CELESTE_GMAIL_TOKEN_FILE=C:\Dev\Celeste\celeste-dev\celeste-core\.secrets\gmail-token.json

# Optional Gmail unread monitor. 0 = disabled. Non-zero values are clamped
# between 60 and 3600 seconds. It only creates local Celeste notices; it does
# not reply, draft or send mail automatically.
CELESTE_GMAIL_POLL_SECONDS=0

# Google Calendar V0.4.2 is opt-in. By default it reuses the same Google Desktop
# OAuth client JSON already used for Gmail, but stores a separate least-privilege
# calendar token requesting only calendar.events.
CELESTE_CALENDAR_ENABLED=false
# CELESTE_CALENDAR_CREDENTIALS_FILE=C:\Dev\Celeste\celeste-dev\celeste-core\.secrets\gmail-credentials.json
# CELESTE_CALENDAR_TOKEN_FILE=C:\Dev\Celeste\celeste-dev\celeste-core\.secrets\calendar-token.json

# Persistent local reminders are always available when Core is running. This is
# how often Core checks the local SQLite scheduler for due reminders.
CELESTE_REMINDER_POLL_SECONDS=2

# Privacy notes:
# - Celeste's OpenAI provider sends Responses requests with store=false.
# - The Ollama provider talks to the configured local Ollama endpoint.
# - Gmail/Calendar OAuth credentials and tokens stay local and are ignored by Git.
# - Calendar V0.4.2 does not expose attendees/invitations to the AI provider.
# - Do not place API keys, OAuth refresh tokens or other secrets in Celeste Brain notes.
