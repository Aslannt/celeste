# Widget de escritorio de Celeste. Copiar a celeste-desktop/.env (no versionado).
# Si no hay .env aqui, el widget intenta leer CELESTE_API_TOKEN de ../celeste-core/.env.
CELESTE_URL=http://127.0.0.1:8000
CELESTE_API_TOKEN=replace-with-your-core-token

# Parte del nombre del microfono a usar (ver `python -m sounddevice`). Vacio = el predeterminado de Windows.
# CELESTE_MIC=Realtek

# Whisper local. large-v3-turbo en GPU (~0.3 s por frase); sin GPU cae solo a small en CPU.
# CELESTE_WHISPER_MODEL=large-v3-turbo

# Voz Piper (archivo en voices/<nombre>.onnx). Descargar con:
#   .venv\Scripts\python -m piper.download_voices es_MX-claude-high --data-dir voices
# CELESTE_VOICE=es_MX-claude-high
